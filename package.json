{
  "name": "ciphered-souls-private-server",
  "version": "0.1.0",
  "description": "Ciphered Souls private server foundation with desktop client shell.",
  "main": "desktop/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "CIPHERED_SOULS_ENV=DEV node src/server.js",
    "client": "electron desktop/main.js",
    "desktop": "electron desktop/main.js",
    "pack:win": "electron-builder --win --dir --publish=never",
    "dist:win": "electron-builder --win nsis --x64 --publish=never",
    "validate": "node scripts/validate-data.js",
    "test": "node scripts/validate-data.js"
  },
  "build": {
    "appId": "com.cipheredsouls.client",
    "productName": "Ciphered Souls",
    "directories": { "output": "release" },
    "files": ["desktop/**/*", "src/**/*", "public/**/*", "data/**/*", "package.json"],
    "win": { "target": ["nsis"] },
    "publish": null,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ciphered Souls"
    }
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "engines": { "node": ">=18.0.0" },
  "license": "UNLICENSED"
}
